{
  "name": "@local/dsh-persona-cards",
  "version": "0.1.0",
  "private": true,
  "description": "Custom persona presets for DeepSeek Harness: a persona card (prefix + suffix) that you turn on by choosing its preset for a session.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "NOTES.md",
    "scripts/*.mjs"
  ],
  "icon": "icon.svg",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "new-card": "node scripts/new-card.mjs"
  }
}
